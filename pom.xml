<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>ru.example</groupId>
    <artifactId>ukep-sign-service</artifactId>
    <version>1.0.0</version>
    <name>ukep-sign-service</name>
    <description>УКЭП: подписание документов через КриптоПро Browser plug-in</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Единый ключ SonarQube (иначе Maven использует groupId:artifactId).
             host.url/sources/binaries задаются при запуске скана, не здесь:
             иначе на сервере без SonarQube mvn sonar:sonar упадёт. -->
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.projectKey>afinaz</sonar.projectKey>
        <sonar.projectName>AfinaZ</sonar.projectName>
        <cryptopro.version>5.0.49800</cryptopro.version>
        <bouncycastle.version>1.70</bouncycastle.version>
    </properties>

    <dependencies>
        <!-- ============ Spring Boot ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcutil-jdk15on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Healthcheck для Docker и мониторинга -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <dependency>
            <groupId>nz.net.ultraq.thymeleaf</groupId>
            <artifactId>thymeleaf-layout-dialect</artifactId>
            <version>3.2.1</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- ============ База данных ============ -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============ КриптоПро JAR (установлены в локальный ~/.m2) ============ -->
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>jcsp</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>jcp</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>jcryptop</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>jcp-revcheck</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>jcp-revtools</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>cades</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>ades-core</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>asn1p</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>asn1rt</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>cmsutil</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>jcp-xml</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>xades</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>xmldsigri</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.cryptopro.jcsp</groupId>
            <artifactId>rutoken</artifactId>
            <version>${cryptopro.version}</version>
        </dependency>

        <!-- ============ ZIP с паролем (бэкап ключей) ============ -->
        <dependency>
            <groupId>net.lingala.zip4j</groupId>
            <artifactId>zip4j</artifactId>
            <version>2.11.5</version>
        </dependency>

        <!-- ============ BouncyCastle ============ -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk15on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- ============ Тесты ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ukep-sign-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>5.8.0.7211</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
