# ============================================================
# Афина · Production secrets
# ============================================================
# Скопируй в .env.prod и заполни. Не коммить в git!
# ============================================================

# ---- Домен ----
APP_DOMAIN=afina.example.ru
APP_BASE_URL=https://afina.example.ru
SECURE_COOKIES=true

# ---- Порты ----
# Наружные порты (на хосте). Если 80/443 заняты — поменяй.
HTTP_PORT=80
HTTPS_PORT=443

# ---- TLS ----
# letsencrypt — Angie сам выпустит через Let's Encrypt (нужен открытый порт 80)
# custom      — использовать свой сертификат из ./angie-certs/
#               (fullchain.pem + privkey.pem, права 600 на ключ)
TLS_MODE=letsencrypt

# ---- PostgreSQL ----
DB_NAME=afina_db
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD

DB_USER=afina_app
DB_PASSWORD=CHANGE_ME_APP_PASSWORD

DB_MIGRATOR_USER=afina_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD

DB_AUDITOR_USER=afina_auditor
DB_AUDITOR_PASSWORD=CHANGE_ME_AUDITOR_PASSWORD

# ---- Admin IP whitelist ----
# Через запятую. Если приложение за Angie — оставь только localhost,
# потому что Angie проксирует с внутреннего IP.
ADMIN_IP_WHITELIST=127.0.0.1,::1,172.0.0.0/8

# ---- Почта (SMTP) ----
MAIL_MODE=smtp
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=587
MAIL_USERNAME=afina@company.ru
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=afina@company.ru
MAIL_SSL=false
# ⚠️ Для порта 587 обязательно STARTTLS, иначе 530 Must issue STARTTLS
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ---- Прочее ----
CRYPTO_PRO_ENABLED=true
