# ============================================================
# Афина · Production secrets
# ============================================================
# Скопируй в .env.prod и заполни. Не коммить в git!
# ============================================================

# ---- Домен ----
APP_DOMAIN=afina.example.ru
APP_BASE_URL=https://afina.example.ru
SECURE_COOKIES=true

# ---- Порты ----
# Наружные порты (на хосте). Если 80/443 заняты — поменяй.
HTTP_PORT=80
HTTPS_PORT=443

# ---- TLS ----
# letsencrypt — Angie сам выпустит через Let's Encrypt (нужен открытый порт 80)
# custom      — использовать свой сертификат из ./angie-certs/
#               (fullchain.pem + privkey.pem, права 600 на ключ)
TLS_MODE=letsencrypt

# ---- PostgreSQL ----
DB_NAME=afina_db
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD

DB_USER=afina_app
DB_PASSWORD=CHANGE_ME_APP_PASSWORD

DB_MIGRATOR_USER=afina_migrator
DB_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD

DB_AUDITOR_USER=afina_auditor
DB_AUDITOR_PASSWORD=CHANGE_ME_AUDITOR_PASSWORD

# ---- Admin IP whitelist ----
# Через запятую. Если приложение за Angie — оставь только localhost,
# потому что Angie проксирует с внутреннего IP.
ADMIN_IP_WHITELIST=127.0.0.1,::1,172.0.0.0/8

# ---- Почта (SMTP) ----
# ВАРИАНТ 1 (по умолчанию, локальный Postfix на этом же сервере):
#   install.sh автоматически добавит Docker-сети в mynetworks Postfix.
#   Порт 25, без auth, без шифрования (внутри localhost — безопасно).
MAIL_MODE=smtp
MAIL_HOST=mail.example.ru
MAIL_PORT=25
MAIL_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.ru
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# ВАРИАНТ 2 (внешний SMTP: Yandex, Mailgun, SendGrid, корпоративный):
# MAIL_HOST=smtp.yandex.ru
# MAIL_PORT=587
# MAIL_SSL=false
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_USERNAME=afina@company.ru
# MAIL_PASSWORD=<app-password>

# ВАРИАНТ 3 (внешний SMTP с implicit SSL, например mail.ru 465):
# MAIL_HOST=smtp.mail.ru
# MAIL_PORT=465
# MAIL_SSL=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
# MAIL_USERNAME=...
# MAIL_PASSWORD=...

# ---- Прочее ----
CRYPTO_PRO_ENABLED=true
